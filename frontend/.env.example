# Routing backend base URL (FastAPI). Optional - without this variable the app uses
# DEFAULT_API_BASE_URL from src/lib/services/routes.ts (also used by Vercel builds).
# Set it to an empty value (VITE_API_BASE_URL=) to use mock routes instead.
# VITE_API_BASE_URL=https://opacity-hypnotism-footless.ngrok-free.dev
