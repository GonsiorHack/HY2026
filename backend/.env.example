# Informacja: ten plik NIE jest ladowany automatycznie.
# backend/.env zawiera tylko istniejacy klucz ORS, nie zmienne czatu.
# Ustaw konfiguracje w powloce przez export, np.:
# export OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Domyslnie taki sam jak OLLAMA_MODEL:
OLLAMA_VERIFY_MODEL=qwen2.5:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=50
CHAT_TOTAL_TIMEOUT_SECONDS=110
CHAT_MAX_CONCURRENT_REQUESTS=2
CHAT_ACQUIRE_TIMEOUT_SECONDS=1
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
